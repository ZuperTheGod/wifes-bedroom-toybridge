<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>ApkPatcher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UndertaleModLib">
      <HintPath>E:\Downloads\UndertaleModTool_nightly-Windows\UndertaleModLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Underanalyzer">
      <HintPath>E:\Downloads\UndertaleModTool_nightly-Windows\Underanalyzer.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>E:\Downloads\UndertaleModTool_nightly-Windows\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Built from android\PhoneImportActivity.java by android\build_dex.cmd. Embedded rather than
         shipped beside the exe, so there is no extra file to forget when deploying. -->
    <EmbeddedResource Include="android\phone_import.dex" LogicalName="phone_import.dex" />
  </ItemGroup>

  <ItemGroup>
    <None Include="apksigner.jar">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
